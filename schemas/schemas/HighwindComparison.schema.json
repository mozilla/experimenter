{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "title": "HighwindComparison",
  "type": "object",
  "properties": {
    "absolute": {
      "$ref": "#/$defs/HighwindInterval"
    },
    "branch": {
      "type": "string"
    },
    "direction": {
      "$ref": "#/$defs/HighwindDirection"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "n_reference": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "n_treatment": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "reference_branch": {
      "type": "string"
    },
    "relative": {
      "$ref": "#/$defs/HighwindInterval"
    },
    "state": {
      "$ref": "#/$defs/HighwindCellState"
    }
  },
  "required": [
    "branch",
    "reference_branch",
    "state",
    "direction",
    "relative",
    "absolute",
    "n_reference",
    "n_treatment",
    "error"
  ],
  "additionalProperties": false,
  "$defs": {
    "HighwindCellState": {
      "enum": [
        "not_started",
        "insufficient_data",
        "forming",
        "confident",
        "error"
      ],
      "type": "string"
    },
    "HighwindDirection": {
      "enum": [
        "positive",
        "negative",
        "neutral"
      ],
      "type": "string"
    },
    "HighwindInterval": {
      "additionalProperties": false,
      "properties": {
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "point": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "point",
        "lower",
        "upper"
      ],
      "type": "object"
    }
  }
}
